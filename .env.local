# Local Development Configuration
# Dùng khi chạy Python app ngoài Docker, kết nối vào services trong Docker

APP_ENV=dev

# Database - connect to Docker container via localhost
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@localhost:5432/football_law

# Ollama - connect to Docker container via localhost
OLLAMA_URL=http://localhost:11434

# Models
CHAT_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Retrieval
TOP_K=8

# Data directory (local path)
PDF_DIR=./data/raw
